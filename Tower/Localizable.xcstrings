    "订阅内容、节点凭据和转换结果都只保存在这台设备上。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ الاشتراكات وبيانات اعتماد العقدة ونتائج التحويل على هذا الجهاز فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements, Knotenanmeldeinformationen und Konvertierungsergebnisse werden nur auf diesem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions, node credentials, and conversion results are only saved on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones, las credenciales de nodo y los resultados de la conversión solo se guardan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements, les informations d'identification du nœud et les résultats de conversion sont uniquement enregistrés sur cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan, kredensial node, dan hasil konversi hanya disimpan di perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプション、ノード認証情報、変換結果はこのデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독, 노드 자격 증명, 변환 결과는 이 장치에만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinaturas, credenciais de nó e resultados de conversão são salvos apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки, учетные данные узла и результаты преобразования сохраняются только на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิก ข้อมูลรับรองโหนด และผลลัพธ์การแปลงจะถูกบันทึกไว้ในอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, düğüm kimlik bilgileri ve dönüşüm sonuçları yalnızca bu cihaza kaydedilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký, thông tin xác thực nút và kết quả chuyển đổi chỉ được lưu trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅内容、节点凭据和转换结果都只保存在这台设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱內容、節點憑證和轉換結果都只保存在這台裝置上。"
          }
        }
      }
    },
