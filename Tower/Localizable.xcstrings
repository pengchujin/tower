      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الإغلاق، ستقوم مجموعة السياسات في التكوين الذي تم تصديره بإزالة الرموز التعبيرية الرائدة في وقت واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Schließen entfernt die Richtliniengruppe in der exportierten Konfiguration gleichzeitig das führende Emoji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After closing, the policy group in the exported configuration will remove the leading Emoji simultaneously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después del cierre, el grupo de políticas en la configuración exportada eliminará el Emoji principal simultáneamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la fermeture, le groupe de stratégies dans la configuration exportée supprimera simultanément le premier Emoji."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah ditutup, grup kebijakan dalam konfigurasi yang diekspor akan menghapus Emoji utama secara bersamaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた後、エクスポートされた構成内のポリシー グループは先頭の絵文字を同時に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫은 후에는 내보낸 구성의 정책 그룹이 주요 Emoji를 동시에 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após o fechamento, o grupo de políticas na configuração exportada removerá o Emoji principal simultaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После закрытия группа политик в экспортированной конфигурации одновременно удалит ведущие эмодзи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากปิด กลุ่มนโยบายในการกำหนดค่าที่ส่งออกจะลบอีโมจินำหน้าพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattıktan sonra dışa aktarılan yapılandırmadaki politika grubu, önde gelen Emojiyi aynı anda kaldıracaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đóng, nhóm chính sách trong cấu hình đã xuất sẽ đồng thời xóa Biểu tượng cảm xúc hàng đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，导出配置里的策略组会同步移除开头的 Emoji。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，匯出設定裡的策略群組會同步移除開頭的 Emoji。"
          }
        }
      }
    },
