    "让手机和电脑或路由器连接同一个 Wi-Fi。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل هاتفك وجهاز الكمبيوتر أو جهاز التوجيه بنفس شبكة Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihr Telefon und Ihren Computer oder Router mit demselben WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your phone and computer or router to the same Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte su teléfono y computadora o enrutador al mismo Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre téléphone et votre ordinateur ou routeur au même réseau Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan ponsel dan komputer atau router Anda ke Wi-Fi yang sama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話とコンピューターまたはルーターを同じ Wi-Fi に接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰과 컴퓨터 또는 라우터를 동일한 Wi-Fi에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu telefone e computador ou roteador ao mesmo Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телефон и компьютер или маршрутизатор к одному Wi-Fi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโทรศัพท์และคอมพิวเตอร์หรือเราเตอร์ของคุณกับ Wi-Fi เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzu ve bilgisayarınızı veya yönlendiricinizi aynı Wi-Fi'ye bağlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối điện thoại và máy tính hoặc bộ định tuyến của bạn với cùng một mạng Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让手机和电脑或路由器连接同一个 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓手機和電腦或路由器連接同一個 Wi-Fi。"
          }
