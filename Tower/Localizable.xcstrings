    "订阅到期还剩 1 天，请及时续费。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي يوم واحد قبل انتهاء الاشتراك، يرجى التجديد في الوقت المناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt noch 1 Tag, bis das Abonnement abläuft. Bitte verlängern Sie es rechtzeitig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This subscription expires in 1 day. Renew it soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda 1 día antes de que caduque la suscripción, renueve a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste 1 jour avant l'expiration de l'abonnement, veuillez le renouveler à temps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada 1 hari tersisa sebelum langganan berakhir, harap perbarui tepat waktu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションの有効期限まであと 1 日あります。期限内に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 만료일까지 1일 남았습니다. 기한 내에 갱신하시기 바랍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta 1 dia para a assinatura expirar, renove a tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До истечения срока действия подписки остался 1 день, пожалуйста, продлите ее вовремя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือเวลาอีก 1 วันก่อนการสมัครจะหมดอายุ โปรดต่ออายุให้ทันเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğin sona ermesine 1 gün kaldı, lütfen zamanında yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn 1 ngày nữa là gói đăng ký sẽ hết hạn, vui lòng gia hạn kịp thời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅到期还剩 1 天，请及时续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱到期還剩 1 天，請及時續費。"
          }
        }
      }
    },
