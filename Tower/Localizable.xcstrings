    "默认 30 秒检查、30 秒超时、保留 0 个；不确定时保持默认。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الافتراضي هو 30 ثانية للتحقق، 30 ثانية مهلة، 0 محجوز؛ احتفظ بالافتراضي إذا لم تكن متأكدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standardwert ist 30 Sekunden Prüfung, 30 Sekunden Zeitüberschreitung, 0 reserviert; Behalten Sie die Standardeinstellung bei, wenn Sie unsicher sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is 30 seconds check, 30 seconds timeout, 0 reserved; keep default if unsure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado es verificación de 30 segundos, tiempo de espera de 30 segundos, 0 reservado; mantenga el valor predeterminado si no está seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut est une vérification de 30 secondes, un délai d'attente de 30 secondes, 0 réservé ; conserver la valeur par défaut en cas de doute."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaultnya adalah pemeriksaan 30 detik, batas waktu 30 detik, 0 dicadangkan; pertahankan default jika tidak yakin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトは 30 秒のチェック、30 秒のタイムアウト、0 予約です。不明な場合はデフォルトのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 확인 30초, 시간 초과 30초, 0 예약입니다. 확실하지 않으면 기본값을 유지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão é verificação de 30 segundos, tempo limite de 30 segundos, 0 reservado; mantenha o padrão se não tiver certeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию — проверка 30 секунд, тайм-аут 30 секунд, 0 зарезервировано; оставьте значение по умолчанию, если не уверены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้นคือการตรวจสอบ 30 วินาที, หมดเวลา 30 วินาที, 0 สงวนไว้; คงค่าเริ่มต้นหากไม่แน่ใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan 30 saniye kontrol, 30 saniye zaman aşımı, 0 ayrılmıştır; Emin değilseniz varsayılanı koruyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định là kiểm tra 30 giây, hết thời gian 30 giây, dành riêng 0; giữ mặc định nếu không chắc chắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 30 秒检查、30 秒超时、保留 0 个；不确定时保持默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 30 秒檢查、30 秒超時、保留 0 個；不確定時保持預設。"
          }
        }
      }
    },
