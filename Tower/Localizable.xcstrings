    "把链接作为订阅地址添加到客户端，刷新时保持塔台在前台打开。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الرابط إلى العميل كعنوان اشتراك وأبقِ البرج مفتوحًا في المقدمة عند التحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Link zum Client als Abonnementadresse hinzu und lassen Sie den Tower beim Aktualisieren im Vordergrund geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the link to the client as a subscription address and keep the tower open in the foreground when refreshing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue el enlace al cliente como dirección de suscripción y mantenga la torre abierta en primer plano cuando se actualice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le lien vers le client comme adresse d'abonnement et gardez la tour ouverte au premier plan lors de l'actualisation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tautan ke klien sebagai alamat berlangganan dan biarkan menara tetap terbuka di latar depan saat menyegarkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをサブスクリプション アドレスとしてクライアントに追加し、更新時にタワーをフォアグラウンドで開いたままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트에 대한 링크를 구독 주소로 추가하고 새로 고칠 때 타워를 전경에 열어두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o link do cliente como endereço de assinatura e mantenha a torre aberta em primeiro plano ao atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ссылку на клиента в качестве адреса подписки и оставьте башню открытой на переднем плане при обновлении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มลิงก์ไปยังไคลเอนต์เป็นที่อยู่การสมัครสมาชิก และเปิดหอคอยไว้เบื้องหน้าเมื่อทำการรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı istemciye abonelik adresi olarak ekleyin ve yenileme sırasında kuleyi ön planda açık tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm liên kết đến máy khách làm địa chỉ đăng ký và giữ cho tháp mở ở nền trước khi làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把链接作为订阅地址添加到客户端，刷新时保持塔台在前台打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把連結作為訂閱位址加入到客戶端，刷新時保持塔台在前台打開。"
          }
        }
      }
    },
