            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bỏ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "取消勾选后，该分组对应的规则不会导出；它依赖的底层策略会按需自动保留。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إلغاء التحديد، لن يتم تصدير القواعد المقابلة لهذه المجموعة؛ سيتم الاحتفاظ بالسياسات الأساسية التي تعتمد عليها تلقائيًا حسب الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Deaktivieren werden die dieser Gruppe entsprechenden Regeln nicht exportiert. Die zugrunde liegenden Richtlinien, von denen es abhängt, werden bei Bedarf automatisch beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After unchecking, the rules corresponding to this group will not be exported; the underlying policies it depends on will be automatically retained as needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de desmarcar, las reglas correspondientes a este grupo no se exportarán; las políticas subyacentes de las que depende se conservarán automáticamente según sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après décoche, les règles correspondant à ce groupe ne seront pas exportées ; les politiques sous-jacentes dont il dépend seront automatiquement conservées selon les besoins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah menghapus centang, aturan yang terkait dengan grup ini tidak akan diekspor; kebijakan mendasar yang menjadi sandarannya akan secara otomatis dipertahankan sesuai kebutuhan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックを外すと、このグループに対応するルールはエクスポートされません。依存する基礎となるポリシーは、必要に応じて自動的に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택을 취소하면 이 그룹에 해당하는 규칙은 내보내지지 않습니다. 의존하는 기본 정책은 필요에 따라 자동으로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após desmarcar, as regras correspondentes a este grupo não serão exportadas; as políticas subjacentes das quais depende serão automaticamente retidas conforme necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После снятия галочки правила, соответствующие этой группе, экспортироваться не будут; базовые политики, от которых он зависит, будут автоматически сохраняться по мере необходимости."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากยกเลิกการเลือก กฎที่เกี่ยวข้องกับกลุ่มนี้จะไม่ถูกส่งออก นโยบายพื้นฐานที่ขึ้นอยู่กับจะถูกเก็บรักษาไว้โดยอัตโนมัติตามความจำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretin kaldırılmasının ardından bu gruba karşılık gelen kurallar dışa aktarılmayacaktır; bağlı olduğu temel politikalar gerektiğinde otomatik olarak korunacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bỏ chọn, các quy tắc tương ứng với nhóm này sẽ không được xuất; các chính sách cơ bản mà nó phụ thuộc vào sẽ được tự động giữ lại khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾选后，该分组对应的规则不会导出；它依赖的底层策略会按需自动保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾選後，該分組對應的規則不會匯出；它所依賴的底層策略會按需自動保留。"
          }
        }
      }
    },
    "取消勾选的节点仍保存在塔台中，但不会写入任何客户端配置。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال يتم حفظ العقد غير المحددة في البرج، ولكن لا تتم كتابة أي تكوين للعميل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungeprüfte Knoten werden weiterhin im Tower gespeichert, es wird jedoch keine Client-Konfiguration geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unchecked nodes remain in Tower but are excluded from every exported profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nodos no marcados todavía se guardan en la torre, pero no se escribe ninguna configuración del cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds non cochés sont toujours enregistrés dans la tour, mais aucune configuration client n'est écrite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Node yang tidak dicentang masih disimpan di menara, tetapi tidak ada konfigurasi klien yang ditulis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックされていないノードは引き続きタワーに保存されますが、クライアント構成は書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인되지 않은 노드는 여전히 타워에 저장되지만 클라이언트 구성은 기록되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nós não verificados ainda são salvos na torre, mas nenhuma configuração do cliente é gravada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непроверенные узлы по-прежнему сохраняются в башне, но конфигурация клиента не записывается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหนดที่ไม่ได้ตรวจสอบจะยังคงบันทึกไว้ในทาวเวอร์ แต่ไม่มีการเขียนการกำหนดค่าไคลเอนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetlenmeyen düğümler hâlâ kulede kayıtlıdır ancak istemci yapılandırması yazılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nút không được chọn vẫn được lưu trong tháp nhưng không có cấu hình máy khách nào được ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾选的节点仍保存在塔台中，但不会写入任何客户端配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾選的節點仍保存在塔台中，但不會寫入任何客戶端設定。"
          }
        }
      }
    },
    "另有 %lld 个节点暂时无法按 IP 或名称定位，仍可正常测试与导出。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عقد %lld أخرى لا يمكن تحديد موقعها عن طريق IP أو الاسم مؤقتًا، ولكن لا يزال من الممكن اختبارها وتصديرها بشكل طبيعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt weitere %lld-Knoten, die vorübergehend nicht anhand der IP oder des Namens lokalisiert werden können, aber dennoch normal getestet und exportiert werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are another %lld nodes that cannot be located by IP or name temporarily, but can still be tested and exported normally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otros nodos %lld que no se pueden ubicar temporalmente por IP o nombre, pero aún se pueden probar y exportar normalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe d'autres nœuds %lld qui ne peuvent pas être localisés temporairement par IP ou par nom, mais qui peuvent toujours être testés et exportés normalement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada node %lld lain yang tidak dapat ditemukan berdasarkan IP atau namanya untuk sementara, tetapi masih dapat diuji dan diekspor secara normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的に IP または名前で特定できない別の %lld ノードがありますが、テストとエクスポートは正常に実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 IP나 이름으로 찾을 수 없지만 정상적으로 테스트하고 내보낼 수 있는 또 다른 %lld 노드가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem outros nós %lld que não podem ser localizados temporariamente por IP ou nome, mas ainda podem ser testados e exportados normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть еще узлы %lld, которые временно невозможно найти по IP или имени, но их все равно можно протестировать и экспортировать в обычном режиме."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีโหนด %lld อื่นที่ไม่สามารถระบุตำแหน่งด้วย IP หรือชื่อได้ชั่วคราว แต่ยังสามารถทดสอบและส่งออกได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici olarak IP'ye veya isme göre bulunamayan ancak yine de normal şekilde test edilip dışa aktarılabilen başka %lld düğümleri daha var."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có một nút %lld khác tạm thời không thể định vị được theo IP hoặc tên nhưng vẫn có thể được kiểm tra và xuất bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 个节点暂时无法按 IP 或名称定位，仍可正常测试与导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 個節點暫時無法依 IP 或名稱定位，仍可正常測試與匯出。"
          }
        }
      }
    },
    "只保留节点选择、自动选择、直连与拦截，策略组最少。": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ فقط باختيار العقدة والاختيار التلقائي والاتصال المباشر والاعتراض، مع أقل مجموعة سياسات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Knotenauswahl, automatische Auswahl, direkte Verbindung und Abfangen bleiben erhalten, mit der geringsten Richtliniengruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only node selection, automatic selection, direct connection and interception are retained, with the least policy group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se conservan la selección de nodos, la selección automática, la conexión directa y la interceptación, con el menor grupo de políticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules la sélection de nœud, la sélection automatique, la connexion directe et l'interception sont conservées, avec le plus petit groupe de politiques."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemilihan node, pemilihan otomatis, koneksi langsung, dan intersepsi yang dipertahankan, dengan grup kebijakan paling sedikit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小のポリシー グループを使用して、ノード選択、自動選択、直接接続、およびインターセプトのみが保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소한의 정책 그룹으로 노드 선택, 자동 선택, 직접 연결 및 차단만 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a seleção de nós, a seleção automática, a conexão direta e a interceptação são mantidas, com o menor grupo de políticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются только выбор узла, автоматический выбор, прямое соединение и перехват с наименьшим количеством групп политик."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงการเลือกโหนด การเลือกอัตโนมัติ การเชื่อมต่อโดยตรง และการสกัดกั้นเท่านั้นที่ยังคงอยู่ โดยมีกลุ่มนโยบายน้อยที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az politika grubuyla yalnızca düğüm seçimi, otomatik seçim, doğrudan bağlantı ve müdahale korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lựa chọn nút, lựa chọn tự động, kết nối trực tiếp và chặn được giữ lại, với nhóm chính sách ít nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留节点选择、自动选择、直连与拦截，策略组最少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留節點選擇、自動選擇、直連與攔截，策略群組最少。"
          }
        }
      }
    },
    "只在您按下时联网": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا اتصال إلا حين تطلبه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netz nur, wenn Sie es auslösen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes online only when you say so"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se conecta cuando usted lo pide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne se connecte que si vous le demandez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung hanya saat Anda memintanya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信はあなたが操作したときだけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크는 사용자가 누를 때만"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só vai à rede quando você manda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит в сеть только по вашей команде"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อเน็ตเฉพาะตอนที่คุณสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca siz istediğinizde çevrimiçi olur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ kết nối mạng khi bạn yêu cầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在您按下时联网"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在您按下時連網"
          }
        }
      }
    },
    "只对这个订阅生效。DNS 请填写 https://…/dns-query 形式的加密解析地址。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعالة فقط لهذا الاشتراك. DNS يرجى ملء عنوان الحل المشفر على شكل https://…/dns-query."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur gültig für dieses Abonnement. DNS Bitte geben Sie die verschlüsselte Auflösungsadresse im Format https://…/dns-query ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only effective for this subscription. DNS Please fill in the encrypted resolution address in the form of https://…/dns-query."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo efectivo para esta suscripción. DNS Complete la dirección de resolución cifrada en el formato https://…/dns-query."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement en vigueur pour cet abonnement. DNS Veuillez remplir l'adresse de résolution cryptée sous la forme https://…/dns-query."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya efektif untuk langganan ini. DNS Silakan isi alamat resolusi terenkripsi dalam bentuk https://…/dns-query."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサブスクリプションに対してのみ有効です。 DNS 暗号化された解決アドレスを https://…/dns-query の形式で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구독에만 유효합니다. DNS 암호화된 확인 주소를 https://…/dns-query 형식으로 입력해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efetivo apenas para esta assinatura. DNS Preencha o endereço de resolução criptografado no formato https://…/dns-query."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует только для этой подписки. DNS Пожалуйста, заполните зашифрованный адрес разрешения в форме https://…/dns-query."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลเฉพาะกับการสมัครสมาชิกนี้เท่านั้น DNS โปรดกรอกที่อยู่การแก้ไขที่เข้ารหัสในรูปแบบ https://…/dns-query"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu abonelik için geçerlidir. DNS Lütfen şifrelenmiş çözüm adresini https://…/dns-query şeklinde doldurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có hiệu lực cho đăng ký này. DNS Vui lòng điền địa chỉ độ phân giải được mã hóa theo dạng https://…/dns-query."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只对这个订阅生效。DNS 请填写 https://…/dns-query 形式的加密解析地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只對這個訂閱生效。 DNS 請填寫 https://…/dns-query 形式的加密解析位址。"
          }
        }
      }
    },
