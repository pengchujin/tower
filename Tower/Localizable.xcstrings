    "请检查相机权限，或切换到粘贴识别。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء التحقق من أذونات الكاميرا، أو التبديل إلى التعرف على اللصق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte überprüfen Sie die Kameraberechtigungen oder wechseln Sie zur Einfügeerkennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check camera permissions, or switch to paste recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique los permisos de la cámara o cambie para pegar reconocimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier les autorisations de la caméra ou passer à la reconnaissance par collage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan periksa izin kamera, atau alihkan ke tempelkan pengenalan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの許可を確認するか、貼り付け認識に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한을 확인하시거나 붙여넣기 인식으로 전환해주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as permissões da câmera ou mude para colar o reconhecimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте разрешения камеры или переключитесь на распознавание вставки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดตรวจสอบการอนุญาตของกล้องหรือเปลี่ยนไปใช้การจดจำการวาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen kamera izinlerini kontrol edin veya tanımayı yapıştırmaya geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng kiểm tra quyền của máy ảnh hoặc chuyển sang dán nhận dạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查相机权限，或切换到粘贴识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查相機權限，或切換到貼上辨識。"
          }
        }
      }
    },
    "请检查相机权限，或返回后粘贴二维码中的链接。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
