        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированных правил пока нет. Чтобы добавить их, используйте кнопку в правом верхнем углу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการนำเข้ากฎ ใช้ปุ่มที่มุมขวาบนเพื่อเพิ่มกฎ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz içe aktarılan kural yok, eklemek için sağ üst köşedeki düğmeyi kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quy tắc nào được nhập, hãy sử dụng nút ở góc trên bên phải để thêm chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有导入规则，使用右上角按钮添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有匯入規則，使用右上角按鈕新增。"
          }
        }
      }
    },
    "这个地址返回的是网页，不是配置文件。请使用规则文件本身的地址。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض هذا العنوان صفحة ويب، وليس ملف تكوين. الرجاء استخدام عنوان ملف القواعد نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse gibt eine Webseite zurück, keine Konfigurationsdatei. Bitte verwenden Sie die Adresse der Regeldatei selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address returns a web page, not a configuration file. Please use the address of the rules file itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección devuelve una página web, no un archivo de configuración. Utilice la dirección del archivo de reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse renvoie une page Web, pas un fichier de configuration. Veuillez utiliser l'adresse du fichier de règles lui-même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat ini mengembalikan halaman web, bukan file konfigurasi. Silakan gunakan alamat file aturan itu sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは、構成ファイルではなく、Web ページを返します。ルールファイル自体のアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 구성 파일이 아닌 웹 페이지를 반환합니다. 규칙 파일 자체의 주소를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço retorna uma página web, não um arquivo de configuração. Por favor, use o endereço do próprio arquivo de regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес возвращает веб-страницу, а не файл конфигурации. Пожалуйста, используйте адрес самого файла правил."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่นี้ส่งคืนหน้าเว็บ ไม่ใช่ไฟล์การกำหนดค่า โปรดใช้ที่อยู่ของไฟล์กฎนั้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres bir yapılandırma dosyası değil, bir web sayfası döndürür. Lütfen kurallar dosyasının adresini kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ này trả về một trang web, không phải tệp cấu hình. Vui lòng sử dụng địa chỉ của chính tệp quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地址返回的是网页，不是配置文件。请使用规则文件本身的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個位址回傳的是網頁，不是設定檔。請使用規則文件本身的位址。"
          }
        }
      }
    },
    "这个自有节点会从这台设备移除。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة العقدة الخاصة من هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene Knoten wird von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The own node will be removed from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio nodo será eliminado de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le propre nœud sera supprimé de cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Node sendiri akan dihapus dari perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自ノードがこの装置から削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 노드가 이 기기에서 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio nó será removido deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственный узел будет удален с этого устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหนดของตัวเองจะถูกลบออกจากอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi düğümü bu cihazdan kaldırılacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút riêng sẽ bị xóa khỏi thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个自有节点会从这台设备移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個自有節點會從這台設備移除。"
          }
        }
      }
    },
    "这个规则方案和它下载的规则列表会从这台设备移除。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة نظام القاعدة وقوائم القواعد التي تم تنزيلها من الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Regelschema und seine heruntergeladenen Regellisten werden vom Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule scheme and its downloaded rule lists will be removed from the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esquema de reglas y sus listas de reglas descargadas se eliminarán del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schéma de règles et ses listes de règles téléchargées seront supprimés de l'appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skema aturan dan daftar aturan yang diunduh akan dihapus dari perangkat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルール スキームとそのダウンロードされたルール リストはデバイスから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 구성표와 다운로드한 규칙 목록이 장치에서 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O esquema de regras e suas listas de regras baixadas serão removidos do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема правил и загруженные списки правил будут удалены с устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงร่างกฎและรายการกฎที่ดาวน์โหลดจะถูกลบออกจากอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural şeması ve indirilen kural listeleri cihazdan kaldırılacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lược đồ quy tắc và danh sách quy tắc đã tải xuống sẽ bị xóa khỏi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个规则方案和它下载的规则列表会从这台设备移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個規則方案和它下載的規則清單會從這台裝置移除。"
          }
        }
      }
    },
    "这份方案随 App 打包，完全离线可用。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي هذا الحل مرفقًا مع التطبيق وهو متاح بالكامل دون اتصال بالإنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lösung ist in der App enthalten und vollständig offline verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This solution is packaged with the App and is completely available offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solución viene incluida con la aplicación y está completamente disponible sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette solution est fournie avec l'application et est entièrement disponible hors ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Solusi ini dikemas dengan Aplikasi dan sepenuhnya tersedia secara offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソリューションはアプリにパッケージ化されており、完全にオフラインで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 솔루션은 앱과 함께 패키지되어 있으며 오프라인에서 완전히 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solução vem com o aplicativo e está totalmente disponível offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это решение входит в состав приложения и полностью доступно в автономном режиме."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซลูชันนี้มาพร้อมกับแอปและพร้อมใช้งานแบบออฟไลน์โดยสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çözüm Uygulamayla birlikte paketlenmiştir ve tamamen çevrimdışı olarak kullanılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải pháp này được đóng gói cùng với Ứng dụng và hoàn toàn khả dụng ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份方案随 App 打包，完全离线可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份方案隨 App 打包，完全離線可用。"
          }
        }
      }
    },
    "这组本地自定义规则会被移除，不会修改上游规则文件。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة هذه المجموعة من القواعد المخصصة المحلية ولن يتم تعديل ملف القواعد الأولية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Satz lokaler benutzerdefinierter Regeln wird entfernt und die Upstream-Regeldatei wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This set of local custom rules will be removed and the upstream rules file will not be modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de reglas personalizadas locales se eliminará y el archivo de reglas ascendentes no se modificará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ensemble de règles personnalisées locales sera supprimé et le fichier de règles en amont ne sera pas modifié."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulan aturan adat lokal ini akan dihapus dan file aturan upstream tidak akan diubah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカル カスタム ルールのセットは削除され、上流のルール ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 사용자 정의 규칙 세트는 제거되고 업스트림 규칙 파일은 수정되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de regras personalizadas locais será removido e o arquivo de regras upstream não será modificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот набор локальных пользовательских правил будет удален, а исходный файл правил не будет изменен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดกฎที่กำหนดเองในเครื่องนี้จะถูกลบออก และไฟล์กฎอัปสตรีมจะไม่ได้รับการแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerel özel kurallar kümesi kaldırılacak ve yukarı akış kuralları dosyası değiştirilmeyecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ quy tắc tùy chỉnh cục bộ này sẽ bị xóa và tệp quy tắc ngược dòng sẽ không bị sửa đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这组本地自定义规则会被移除，不会修改上游规则文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這組本機自訂規則會移除，不會修改上游規則檔案。"
          }
        }
      }
    },
    "这里只筛选服务规则；最终兜底和被引用的节点策略会自动保留，避免生成无效配置。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصفية قواعد الخدمة فقط هنا؛ سيتم الاحتفاظ بالسياسة النهائية وسياسات العقدة المشار إليها تلقائيًا لتجنب إنشاء تكوينات غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden nur Serviceregeln gefiltert; Die endgültige Richtlinie und die Richtlinien für referenzierte Knoten werden automatisch beibehalten, um die Generierung ungültiger Konfigurationen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only service rules are filtered here; the final policy and referenced node policies will be automatically retained to avoid generating invalid configurations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí sólo se filtran las reglas de servicio; la política final y las políticas de nodo referenciadas se conservarán automáticamente para evitar generar configuraciones no válidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les règles de service sont filtrées ici ; la politique finale et les politiques de nœud référencé seront automatiquement conservées pour éviter de générer des configurations non valides."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya aturan layanan yang difilter di sini; kebijakan akhir dan kebijakan node yang direferensikan akan disimpan secara otomatis untuk menghindari pembuatan konfigurasi yang tidak valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではサービス ルールのみがフィルタリングされます。最終的なポリシーと参照されたノード ポリシーは、無効な構成が生成されるのを避けるために自動的に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 서비스 규칙만 필터링됩니다. 잘못된 구성이 생성되는 것을 방지하기 위해 최종 정책과 참조된 노드 정책은 자동으로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente regras de serviço são filtradas aqui; a política final e as políticas do nó referenciado serão retidas automaticamente para evitar a geração de configurações inválidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь фильтруются только правила обслуживания; окончательная политика и политики ссылочных узлов будут автоматически сохранены, чтобы избежать создания недопустимых конфигураций."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่กรองเฉพาะกฎการบริการเท่านั้น นโยบายขั้นสุดท้ายและนโยบายโหนดที่อ้างอิงจะถูกเก็บไว้โดยอัตโนมัติเพื่อหลีกเลี่ยงการสร้างการกำหนดค่าที่ไม่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yalnızca hizmet kuralları filtrelenir; geçersiz yapılandırmaların oluşturulmasını önlemek için son politika ve başvurulan düğüm politikaları otomatik olarak korunacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các quy tắc dịch vụ mới được lọc ở đây; chính sách cuối cùng và chính sách nút được tham chiếu sẽ tự động được giữ lại để tránh tạo ra cấu hình không hợp lệ."
          }
        },
        "zh-Hans": {
