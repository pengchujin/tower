    "共享的是转换结果，不含机场原始链接": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مشاركة نتيجة التحويل فقط، من دون رابط الاشتراك الأصلي لمزوّد الخدمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilt wird nur das Konvertierungsergebnis, nicht der ursprüngliche Abonnement-Link des Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the converted result is shared, not the provider's original subscription URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparte el resultado convertido, no la URL de suscripción original del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le résultat converti est partagé, pas l’URL d’abonnement d’origine du fournisseur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya hasil konversi yang dibagikan, bukan URL langganan asli dari penyedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されるのは変換結果のみで、プロバイダーの元のサブスクリプションURLは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환 결과만 공유되며 제공업체의 원본 구독 URL은 포함되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o resultado convertido é compartilhado, não a URL de assinatura original do provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаётся только результат преобразования, без исходной ссылки подписки провайдера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เฉพาะผลลัพธ์ที่แปลงแล้ว ไม่รวม URL การสมัครสมาชิกต้นฉบับของผู้ให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca dönüştürülen sonuç paylaşılır; sağlayıcının özgün abonelik URL'si paylaşılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chia sẻ kết quả đã chuyển đổi, không bao gồm URL đăng ký gốc của nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的是转换结果，不含机场原始链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的是轉換結果，不含機場原始鏈接"
          }
        }
      }
    },
    "关掉的协议不会写进 %@ 的配置，并计入“已跳过”。其他客户端不受影响。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم كتابة البروتوكول الذي تم إيقاف تشغيله في تكوين %@ وسيتم اعتباره \"تم تخطيه\". ولا يتأثر العملاء الآخرون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgeschaltete Protokoll wird nicht in die Konfiguration von %@ geschrieben und als „übersprungen“ gezählt. Andere Clients sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled protocols are excluded from the %@ profile and counted as skipped. Other apps are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El protocolo desactivado no se escribirá en la configuración de %@ y se contará como \"omitido\". Otros clientes no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le protocole désactivé ne sera pas écrit dans la configuration de %@ et sera compté comme « ignoré ». Les autres clients ne sont pas concernés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokol yang dimatikan tidak akan ditulis ke dalam konfigurasi %@ dan akan dihitung sebagai \"dilewati\". Klien lain tidak terpengaruh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにしたプロトコルは %@ の設定には書き込まれず、「スキップ」としてカウントされます。他のクライアントには影響はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼진 프로토콜은 %@ 구성에 기록되지 않으며 \"건너뛰기\"로 간주됩니다. 다른 클라이언트는 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O protocolo desativado não será gravado na configuração de %@ e será contado como \"ignorado\". Outros clientes não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключенный протокол не будет записан в конфигурацию %@ и будет считаться «пропущенным». Другие клиенты не затронуты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรโตคอลที่ถูกปิดจะไม่ถูกเขียนลงในการกำหนดค่าของ %@ และจะถูกนับเป็น \"ข้าม\" ลูกค้ารายอื่นจะไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılan protokol %@ konfigürasyonuna yazılmayacak ve \"atlanmış\" olarak sayılacaktır. Diğer istemciler etkilenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao thức đã tắt sẽ không được ghi vào cấu hình của %@ và sẽ được tính là \"bỏ qua\". Các khách hàng khác không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉的协议不会写进 %@ 的配置，并计入“已跳过”。其他客户端不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉的協定不會寫入 %@ 的配置，併計入「已跳過」。其他客戶端不受影響。"
          }
        }
      }
    },
