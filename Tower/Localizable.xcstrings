    "请使用 HTTPS 订阅地址，避免凭据在网络中明文传输": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى استخدام عنوان اشتراك HTTPS لتجنب نقل النص الواضح لبيانات الاعتماد عبر الشبكة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte verwenden Sie eine HTTPS-Abonnementadresse, um eine Klartextübertragung der Anmeldeinformationen über das Netzwerk zu vermeiden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please use HTTPS subscription address to avoid clear text transmission of credentials over the network"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la dirección de suscripción HTTPS para evitar la transmisión de credenciales en texto claro a través de la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez utiliser l'adresse d'abonnement HTTPS pour éviter la transmission en texte clair des informations d'identification sur le réseau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan gunakan alamat berlangganan HTTPS untuk menghindari transmisi teks kredensial yang jelas melalui jaringan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク上で認証情報が平文で送信されるのを避けるために、HTTPS サブスクリプション アドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크를 통한 자격 증명의 일반 텍스트 전송을 방지하려면 HTTPS 구독 주소를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o endereço de assinatura HTTPS para evitar a transmissão de credenciais em texto não criptografado pela rede"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте адрес подписки HTTPS, чтобы избежать передачи учетных данных в открытом виде по сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดใช้ที่อยู่การสมัคร HTTPS เพื่อหลีกเลี่ยงการส่งข้อมูลรับรองผ่านเครือข่ายด้วยข้อความที่ชัดเจน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik bilgilerinin ağ üzerinden açık metin olarak iletilmesini önlemek için lütfen HTTPS abonelik adresini kullanın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng sử dụng địa chỉ đăng ký HTTPS để tránh truyền văn bản rõ ràng về thông tin xác thực qua mạng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 订阅地址，避免凭据在网络中明文传输"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 HTTPS 訂閱位址，避免憑證在網路中明文傳輸"
          }
        }
      }
    },
