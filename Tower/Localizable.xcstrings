        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld 노드, 건너뛰음 %3$lld 인식되지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld nós, ignorados %3$lld não reconhecidos"
