    "AI、全球流媒体、广告过滤和国内外流量精细分流。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي، ووسائط البث العالمية، وتصفية الإعلانات، والتحويل الدقيق لحركة المرور المحلية والأجنبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI, globale Streaming-Medien, Werbefilterung und feine Umleitung des inländischen und ausländischen Datenverkehrs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, global streaming media, ad filtering and fine diversion of domestic and foreign traffic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, medios de transmisión global, filtrado de anuncios y desvío fino del tráfico nacional y extranjero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, streaming multimédia mondial, filtrage des publicités et détournement fin du trafic national et étranger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, media streaming global, pemfilteran iklan, dan pengalihan lalu lintas dalam dan luar negeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、グローバルストリーミングメディア、広告フィルタリング、国内外のトラフィックの細かい方向転換。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, 글로벌 스트리밍 미디어, 광고 필터링, 국내외 트래픽 미세전환 등."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, streaming media global, filtragem de anúncios e desvio fino de tráfego nacional e estrangeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искусственный интеллект, глобальные потоковые медиа, фильтрация рекламы и точное перенаправление внутреннего и внешнего трафика."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, สื่อสตรีมมิ่งระดับโลก, การกรองโฆษณา และการเปลี่ยนเส้นทางการรับส่งข้อมูลในประเทศและต่างประเทศอย่างละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka, küresel medya akışı, reklam filtreleme ve yerli ve yabancı trafiğin hassas şekilde yönlendirilmesi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, phương tiện truyền thông trực tuyến toàn cầu, lọc quảng cáo và chuyển hướng tốt lưu lượng truy cập trong và ngoài nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、全球流媒体、广告过滤和国内外流量精细分流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、全球串流媒體、廣告過濾和國內外流量精細分流。"
          }
        }
      }
    },
    "AI、流媒体、广告和国内外流量精细分流。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي وتدفق الوسائط والإعلان والتوزيع الدقيق لحركة المرور المحلية والأجنبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI, Streaming Media, Werbung und Feinverteilung von In- und Auslandsverkehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, streaming media, advertising and fine distribution of domestic and foreign traffic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, streaming media, publicidad y distribución fina de tráfico nacional y extranjero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, streaming multimédia, publicité et répartition fine du trafic national et étranger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, media streaming, periklanan, dan distribusi lalu lintas dalam dan luar negeri yang baik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、ストリーミングメディア、広告、国内外のトラフィックのきめ細かな配信。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, 스트리밍 미디어, 광고 및 국내외 트래픽 미세분배."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IA, streaming de mídia, publicidade e distribuição fina de tráfego nacional e estrangeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, потоковое мультимедиа, реклама и тонкое распределение внутреннего и зарубежного трафика."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, สื่อสตรีมมิ่ง, การโฆษณาและการกระจายการเข้าชมในประเทศและต่างประเทศอย่างละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka, medya akışı, reklam ve yerli ve yabancı trafiğin hassas dağıtımı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI, phương tiện truyền thông trực tuyến, quảng cáo và phân phối tốt lưu lượng truy cập trong và ngoài nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、流媒体、广告和国内外流量精细分流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI、串流媒體、廣告和國內外流量精細分流。"
          }
        }
      }
    },
