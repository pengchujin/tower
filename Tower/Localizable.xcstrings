    "不确定就保持默认，由客户端决定。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم تكن متأكدًا فاترك الإعداد الافتراضي وليقرّر العميل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Zweifel die Standardwerte lassen — der Client entscheidet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When unsure, leave the defaults and let the client decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no estás seguro, deja los valores por defecto y que decida el cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le doute, laissez les valeurs par défaut et laissez le client décider."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau ragu, biarkan bawaan dan serahkan pada kliennya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分からないときは既定のままにして、クライアントに任せてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확실하지 않으면 기본값을 두고 클라이언트에 맡기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dúvida, deixe os padrões e deixe o cliente decidir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не уверены, оставьте значения по умолчанию — пусть решает клиент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่แน่ใจ ให้คงค่าเริ่มต้นและปล่อยให้ไคลเอ็นต์ตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin değilseniz varsayılanları bırakın, kararı istemci versin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không chắc, hãy giữ mặc định và để ứng dụng tự quyết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定就保持默认，由客户端决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定就保持預設，由客戶端決定。"
          }
        }
      }
    },
