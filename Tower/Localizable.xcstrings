    "规则列表已下载到本机，生成配置时不再联网。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنزيل قائمة القواعد على الجهاز المحلي ولم تعد متصلة بالإنترنت عند إنشاء التكوين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regelliste wurde auf den lokalen Computer heruntergeladen und ist beim Generieren der Konfiguration nicht mehr mit dem Internet verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule list has been downloaded to the local machine and is no longer connected to the Internet when generating the configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de reglas se descargó en la máquina local y ya no está conectada a Internet al generar la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de règles a été téléchargée sur la machine locale et n'est plus connectée à Internet lors de la génération de la configuration."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar aturan telah diunduh ke mesin lokal dan tidak lagi terhubung ke Internet saat membuat konfigurasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルール リストはローカル マシンにダウンロードされており、構成の生成時にはインターネットに接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 목록이 로컬 시스템에 다운로드되었으며 구성을 생성할 때 더 이상 인터넷에 연결되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de regras foi baixada para a máquina local e não está mais conectada à Internet ao gerar a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список правил был загружен на локальный компьютер и больше не подключен к Интернету при создании конфигурации."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดรายการกฎลงในเครื่องท้องถิ่นแล้ว และไม่ได้เชื่อมต่อกับอินเทอร์เน็ตอีกต่อไปเมื่อสร้างการกำหนดค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural listesi yerel makineye indirildi ve yapılandırma oluşturulurken artık İnternet'e bağlı değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách quy tắc đã được tải xuống máy cục bộ và không còn kết nối với Internet khi tạo cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则列表已下载到本机，生成配置时不再联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則清單已下載至本機，產生設定時不再連網。"
          }
        }
      }
    },
