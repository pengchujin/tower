    "只有你主动开启后才会监听局域网": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم مراقبة الشبكة المحلية إلا إذا قمت بتشغيلها بشكل فعال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das LAN wird nur überwacht, wenn Sie es aktiv einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The LAN will be monitored only if you actively turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La LAN será monitoreada sólo si la enciende activamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau local ne sera surveillé que si vous l'activez activement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN akan dipantau hanya jika Anda aktif menyalakannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN は、積極的にオンにした場合にのみ監視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN은 적극적으로 켜는 경우에만 모니터링됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A LAN será monitorada somente se você a ativar ativamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная сеть будет контролироваться только в том случае, если вы ее активно включите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN จะถูกตรวจสอบเฉพาะเมื่อคุณเปิดใช้งานเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN yalnızca onu aktif olarak açarsanız izlenecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng LAN sẽ chỉ được giám sát nếu bạn chủ động bật nó lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主动开启后才会监听局域网"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主動開啟後才會監聽區域網"
          }
        }
      }
    },
    "只有取订阅和您主动刷新规则时才发请求。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرسَل طلب إلا عند جلب الاشتراك أو عند تحديثك للقواعد بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen entstehen nur beim Abo-Abruf und wenn Sie Regeln selbst aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests happen only when fetching the subscription and when you refresh rules yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay peticiones al obtener la suscripción y cuando usted actualiza las reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des requêtes n’ont lieu qu’au téléchargement de l’abonnement et quand vous actualisez les règles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan hanya terjadi saat mengambil langganan dan saat Anda menyegarkan aturan sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信が起きるのは購読の取得時と、あなたが自分でルールを更新したときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청은 구독을 가져올 때와 직접 규칙을 새로 고칠 때만 발생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só há requisições ao buscar a assinatura e quando você mesmo atualiza as regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы идут только при получении подписки и когда вы сами обновляете правила."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการร้องขอเฉพาะตอนดึงการสมัครสมาชิกและตอนที่คุณรีเฟรชกฎเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstekler yalnızca abonelik alınırken ve kuralları kendiniz yenilediğinizde yapılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có yêu cầu mạng khi lấy gói đăng ký và khi chính bạn làm mới quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有取订阅和您主动刷新规则时才发请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有取訂閱和您主動重新整理規則時才發出請求。"
          }
        }
      }
    },
    "只添加节点订阅，不替换客户端现有的规则和策略组。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إضافة اشتراكات العقدة فقط، ولا يتم استبدال القواعد ومجموعات السياسات الموجودة على العميل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Knotenabonnements hinzugefügt, vorhandene Regeln und Richtliniengruppen auf dem Client werden nicht ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a node subscription without replacing existing rules or policy groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se agregan suscripciones de nodos, las reglas y los grupos de políticas existentes en el cliente no se reemplazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les abonnements aux nœuds sont ajoutés, les règles et groupes de stratégies existants sur le client ne sont pas remplacés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya langganan node yang ditambahkan, aturan dan grup kebijakan yang ada di klien tidak diganti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノード サブスクリプションのみが追加され、クライアント上の既存のルールとポリシー グループは置き換えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 구독만 추가되며 클라이언트의 기존 규칙 및 정책 그룹은 대체되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas assinaturas de nós são adicionadas, regras e grupos de políticas existentes no cliente não são substituídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляются только подписки узлов, существующие правила и группы политик на клиенте не заменяются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเฉพาะการสมัครสมาชิกโหนด กฎและกลุ่มนโยบายที่มีอยู่บนไคลเอนต์จะไม่ถูกแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca düğüm abonelikleri eklenir, istemcideki mevcut kurallar ve ilke grupları değiştirilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đăng ký nút mới được thêm vào, các quy tắc và nhóm chính sách hiện có trên máy khách không được thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只添加节点订阅，不替换客户端现有的规则和策略组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只新增節點訂閱，不替換客戶端現有的規則和策略群組。"
          }
        }
      }
    },
    "可一次粘贴多条链接，每行一条。支持 HTTP 和 HTTPS 订阅，以及 SS、SSR、VMess、VLESS、Trojan、Hysteria 2、AnyTLS、SOCKS5、HTTP(S) 节点。HTTP 订阅会明文传输订阅地址和节点内容。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لصق روابط متعددة، رابط واحد لكل سطر. يدعم اشتراكات HTTP وHTTPS، بالإضافة إلى عقد SS وSSR وVMess وVLESS وTrojan وHysteria 2 وAnyTLS وSOCKS5 وHTTP(S). تنقل اشتراكات HTTP عنوان الاشتراك ومحتوى العقد بنص واضح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Links können eingefügt werden, einer pro Zeile. Unterstützt HTTP- und HTTPS-Abonnements sowie SS-, SSR-, VMess-, VLESS-, Trojan-, Hysteria 2-, AnyTLS-, SOCKS5- und HTTP(S)-Knoten. HTTP-Abonnements übertragen Adresse und Knoteninhalte unverschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste multiple links, one per line. Supports HTTP and HTTPS subscriptions, plus SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5, and HTTP(S) nodes. HTTP subscriptions transmit the subscription URL and node content in clear text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pegar varios enlaces, uno por línea. Admite suscripciones HTTP y HTTPS, además de nodos SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 y HTTP(S). Las suscripciones HTTP transmiten la URL y los nodos sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez plusieurs liens, un par ligne. Prend en charge les abonnements HTTP et HTTPS, ainsi que les nœuds SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 et HTTP(S). Les abonnements HTTP transmettent l’URL et les nœuds en clair."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel beberapa tautan, satu per baris. Mendukung langganan HTTP dan HTTPS, serta node SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5, dan HTTP(S). Langganan HTTP mengirim URL dan isi node tanpa enkripsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のリンクを1行に1つずつ貼り付けられます。HTTP／HTTPSサブスクリプションと、SS、SSR、VMess、VLESS、Trojan、Hysteria 2、AnyTLS、SOCKS5、HTTP(S)ノードに対応します。HTTPサブスクリプションはURLとノード内容を平文で送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 링크를 한 줄에 하나씩 붙여넣을 수 있습니다. HTTP 및 HTTPS 구독과 SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5, HTTP(S) 노드를 지원합니다. HTTP 구독은 구독 URL과 노드 내용을 암호화하지 않고 전송합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole vários links, um por linha. Compatível com assinaturas HTTP e HTTPS, além de nós SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 e HTTP(S). Assinaturas HTTP transmitem a URL e o conteúdo dos nós sem criptografia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вставить несколько ссылок, по одной на строку. Поддерживаются подписки HTTP и HTTPS, а также узлы SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 и HTTP(S). Подписки HTTP передают URL и содержимое узлов в открытом виде."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางได้หลายลิงก์ โดยหนึ่งลิงก์ต่อบรรทัด รองรับการสมัครสมาชิก HTTP และ HTTPS รวมถึงโหนด SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 และ HTTP(S) การสมัครสมาชิก HTTP จะส่ง URL และข้อมูลโหนดโดยไม่เข้ารหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra bir tane olacak şekilde birden fazla bağlantı yapıştırabilirsiniz. HTTP ve HTTPS aboneliklerinin yanı sıra SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 ve HTTP(S) düğümlerini destekler. HTTP abonelikleri URL ve düğüm içeriğini şifrelemeden iletir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể dán nhiều liên kết, mỗi dòng một liên kết. Hỗ trợ đăng ký HTTP và HTTPS, cùng các nút SS, SSR, VMess, VLESS, Trojan, Hysteria 2, AnyTLS, SOCKS5 và HTTP(S). Đăng ký HTTP truyền URL và nội dung nút dưới dạng văn bản rõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可一次粘贴多条链接，每行一条。支持 HTTP 和 HTTPS 订阅，以及 SS、SSR、VMess、VLESS、Trojan、Hysteria 2、AnyTLS、SOCKS5、HTTP(S) 节点。HTTP 订阅会明文传输订阅地址和节点内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可一次貼上多條連結，每行一條。支援 HTTP 和 HTTPS 訂閱，以及 SS、SSR、VMess、VLESS、Trojan、Hysteria 2、AnyTLS、SOCKS5、HTTP(S) 節點。HTTP 訂閱會以明文傳輸訂閱地址和節點內容。"
          }
        }
      }
    },
