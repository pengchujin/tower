    "访问密钥已更换，旧链接已失效": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير مفتاح الوصول ولم يعد الرابط القديم صالحًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugangsschlüssel wurde geändert und der alte Link ist nicht mehr gültig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The access key has been changed and the old link is no longer valid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de acceso ha sido cambiada y el enlace antiguo ya no es válido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'accès a été modifiée et l'ancien lien n'est plus valide"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci akses telah diubah dan tautan lama tidak berlaku lagi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスキーが変更され、古いリンクは無効になりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세스 키가 변경되었으며 이전 링크는 더 이상 유효하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso foi alterada e o link antigo não é mais válido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ доступа был изменен, и старая ссылка больше не действительна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสการเข้าถึงมีการเปลี่ยนแปลงและลิงก์เก่าใช้ไม่ได้อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim anahtarı değiştirildi ve eski bağlantı artık geçerli değil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Key truy cập đã bị thay đổi và link cũ không còn hiệu lực"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问密钥已更换，旧链接已失效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問密鑰已更換，舊連結已失效"
          }
        }
      }
    },
    "该协议请改用协议链接导入": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء استخدام رابط البروتوكول لاستيراد هذا البروتوكول بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte verwenden Sie stattdessen den Protokolllink, um dieses Protokoll zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please use the protocol link to import this protocol instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el enlace del protocolo para importar este protocolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez plutôt utiliser le lien du protocole pour importer ce protocole."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan gunakan tautan protokol untuk mengimpor protokol ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロトコルをインポートするには、代わりにプロトコル リンクを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 이 프로토콜을 가져오려면 프로토콜 링크를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o link do protocolo para importar este protocolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого используйте ссылку на протокол, чтобы импортировать этот протокол."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดใช้ลิงก์โปรโตคอลเพื่อนำเข้าโปรโตคอลนี้แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine bu protokolü içe aktarmak için lütfen protokol bağlantısını kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng sử dụng liên kết giao thức để nhập giao thức này thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该协议请改用协议链接导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該協議請改用協議連結導入"
          }
        }
      }
    },
    "该订阅及已读取的节点会从这台设备移除。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة الاشتراك وعقدة القراءة من هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement und der Leseknoten werden von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription and the read node will be removed from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción y el nodo de lectura se eliminarán de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement et le nœud de lecture seront supprimés de cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan dan node baca akan dihapus dari perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションと読み取りノードがこのデバイスから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 및 읽기 노드가 이 장치에서 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura e o nó de leitura serão removidos deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка и узел чтения будут удалены с этого устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกและโหนดการอ่านจะถูกลบออกจากอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik ve okuma düğümü bu cihazdan kaldırılacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký và nút đọc sẽ bị xóa khỏi thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该订阅及已读取的节点会从这台设备移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該訂閱及已讀取的節點會從這台設備移除。"
          }
        }
      }
    },
    "请使用 HTTPS 规则地址": {
      "localizations": {
