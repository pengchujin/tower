    "%@ 暂不支持完整配置的一键导入": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ استيراد التكوين الكامل بنقرة واحدة غير مدعوم حتى الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Der Ein-Klick-Import der vollständigen Konfiguration wird noch nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ One-click import of complete configuration is not supported yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Aún no se admite la importación con un clic de la configuración completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ L'importation en un clic de la configuration complète n'est pas encore prise en charge."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Impor satu klik untuk konfigurasi lengkap belum didukung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 完全な構成のワンクリックインポートはまだサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 원클릭 전체 구성 가져오기는 아직 지원되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A importação com um clique da configuração completa ainda não é suportada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Импорт полной конфигурации в один клик пока не поддерживается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่รองรับการนำเข้าการกำหนดค่าที่สมบูรณ์เพียงคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tüm konfigürasyonun tek tıklamayla içe aktarılması henüz desteklenmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Chưa hỗ trợ nhập cấu hình hoàn chỉnh bằng một cú nhấp chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暂不支持完整配置的一键导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暫不支援完整配置的一鍵導入"
          }
        }
      }
    },
