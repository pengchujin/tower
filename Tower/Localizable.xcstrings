    "%@ 到期还剩 %lld 天": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بقي %lld يوم على انتهاء الصلاحية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat noch %lld Tage bis zum Ablauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expires in %lld days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ le quedan %lld días hasta el vencimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@ jours %lld jours avant l'expiration"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mempunyai sisa %lld hari hingga habis masa berlakunya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の有効期限まであと %lld 日あります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 만료일까지 %lld일이 남았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem %lld dias restantes até a expiração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ осталось %lld дней до истечения срока действия"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เหลือ %lld วันก่อนหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'nin vadesinin dolmasına %lld gün kaldı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ còn %lld ngày nữa là hết hạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 到期还剩 %lld 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 到期還剩 %lld 天"
          }
        }
      }
    },
    "%@ 到期还剩 1 天": {
