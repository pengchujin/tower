    "所有已经添加到电脑或路由器的塔台订阅链接都会失效。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستصبح جميع روابط اشتراك البرج التي تمت إضافتها إلى الكمبيوتر أو جهاز التوجيه غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tower-Abonnement-Links, die dem Computer oder Router hinzugefügt wurden, werden ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All tower subscription links that have been added to the computer or router will become invalid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los enlaces de suscripción a la torre que se hayan agregado a la computadora o enrutador dejarán de ser válidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les liens d'abonnement à la tour qui ont été ajoutés à l'ordinateur ou au routeur deviendront invalides."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua link berlangganan tower yang telah ditambahkan ke komputer atau router akan menjadi tidak valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターまたはルーターに追加されたすべてのタワー サブスクリプション リンクは無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터나 라우터에 추가된 모든 타워 가입 링크가 무효화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os links de assinatura de torre adicionados ao computador ou roteador se tornarão inválidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ссылки на подписку на вышку, добавленные на компьютер или маршрутизатор, станут недействительными."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์สมัครสมาชิก Tower ทั้งหมดที่เพิ่มลงในคอมพิวเตอร์หรือเราเตอร์จะใช้งานไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
