    "最完整的分组：流媒体、AI、游戏、音乐，并按节点名分出地区组。": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التجميع الأكثر اكتمالاً: وسائط البث، والذكاء الاصطناعي، والألعاب، والموسيقى، والمجموعات الإقليمية حسب اسم العقدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die umfassendste Gruppierung: Streaming-Medien, KI, Spiele, Musik und regionale Gruppen nach Knotennamen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most complete grouping: streaming media, AI, games, music, and regional groups by node name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La agrupación más completa: streaming de medios, IA, juegos, música y grupos regionales por nombre de nodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regroupement le plus complet : streaming multimédia, IA, jeux, musique et groupes régionaux par nom de nœud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengelompokan terlengkap: media streaming, AI, game, musik, dan grup regional berdasarkan nama node."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も完全なグループ化: ノード名ごとのストリーミング メディア、AI、ゲーム、音楽、および地域グループ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 완벽한 그룹화: 스트리밍 미디어, AI, 게임, 음악 및 노드 이름별 지역 그룹."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agrupamento mais completo: streaming de mídia, IA, jogos, música e grupos regionais por nome de nó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая полная группировка: потоковое мультимедиа, AI, игры, музыка и региональные группы по имени узла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจัดกลุ่มที่สมบูรณ์แบบที่สุด: สื่อสตรีมมิ่ง, AI, เกม, เพลง และกลุ่มภูมิภาคตามชื่อโหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En eksiksiz gruplandırma: düğüm adına göre medya akışı, yapay zeka, oyunlar, müzik ve bölgesel gruplar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm đầy đủ nhất: phương tiện truyền phát trực tuyến, AI, trò chơi, âm nhạc và các nhóm khu vực theo tên nút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最完整的分组：流媒体、AI、游戏、音乐，并按节点名分出地区组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最完整的分組：串流媒體、AI、遊戲、音樂，並依節點名分出地區組。"
          }
        }
      }
    },
