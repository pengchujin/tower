    "机场订阅将在明天到期，请及时续费。": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي اشتراك مزوّد الخدمة غدًا. يُرجى تجديده في الوقت المناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anbieter-Abonnement läuft morgen ab. Bitte rechtzeitig verlängern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider subscription expires tomorrow. Renew it to avoid interruption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción del proveedor vence mañana. Renuévala para evitar interrupciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement du fournisseur expire demain. Renouvelez-le pour éviter toute interruption."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan penyedia akan berakhir besok. Perpanjang untuk menghindari gangguan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのサブスクリプションは明日で期限切れになります。早めに更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공업체 구독이 내일 만료됩니다. 중단되지 않도록 갱신하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura do provedor vence amanhã. Renove-a para evitar interrupções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка провайдера истекает завтра. Продлите её, чтобы избежать перерыва."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกของผู้ให้บริการจะหมดอายุพรุ่งนี้ โปรดต่ออายุเพื่อไม่ให้การใช้งานสะดุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı aboneliğinin süresi yarın doluyor. Kesinti yaşamamak için yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký của nhà cung cấp sẽ hết hạn vào ngày mai. Hãy gia hạn để tránh gián đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机场订阅将在明天到期，请及时续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機場訂閱將於明天到期，請及時續費。"
          }
        }
      }
    },
