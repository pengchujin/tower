    "AnyTLS 会话参数必须是大于或等于 0 的整数": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون معلمات جلسة AnyTLS عددًا صحيحًا أكبر من أو يساوي 0"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS-Sitzungsparameter müssen eine Ganzzahl größer oder gleich 0 sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS session parameters must be an integer greater than or equal to 0"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los parámetros de sesión de AnyTLS deben ser un número entero mayor o igual a 0"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de session AnyTLS doivent être un entier supérieur ou égal à 0"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameter sesi AnyTLS harus berupa bilangan bulat yang lebih besar dari atau sama dengan 0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのTLSセッションパラメータは0以上の整数である必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS 세션 매개변수는 0보다 크거나 같은 정수여야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os parâmetros de sessão AnyTLS devem ser um número inteiro maior ou igual a 0"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры сеанса AnyTLS должны быть целым числом, большим или равным 0."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พารามิเตอร์เซสชัน TLS ใดๆ ต้องเป็นจำนวนเต็มที่มากกว่าหรือเท่ากับ 0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS oturum parametreleri 0'dan büyük veya 0'a eşit bir tam sayı olmalıdır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham số phiên AnyTLS phải là số nguyên lớn hơn hoặc bằng 0"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS 会话参数必须是大于或等于 0 的整数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyTLS 會話參數必須是大於或等於 0 的整數"
          }
        }
      }
    },
