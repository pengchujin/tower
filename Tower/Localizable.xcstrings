    "单条内容留空则自动命名": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تم ترك جزء واحد من المحتوى فارغًا، فسيتم تسميته تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein einzelner Inhalt leer bleibt, wird er automatisch benannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a single piece of content is left blank, it will be automatically named."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un solo contenido se deja en blanco, se le asignará un nombre automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un seul élément de contenu reste vide, il sera automatiquement nommé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika satu bagian konten dibiarkan kosong, maka secara otomatis akan diberi nama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの 1 つを空白のままにすると、自動的に名前が付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 하나를 공백으로 남겨두면 자동으로 이름이 지정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um único conteúdo for deixado em branco, ele será nomeado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если какой-либо фрагмент содержимого оставить пустым, ему будет присвоено имя автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเว้นว่างเนื้อหาชิ้นเดียว เนื้อหานั้นจะถูกตั้งชื่อโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir içerik parçası boş bırakılırsa otomatik olarak adlandırılacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một phần nội dung bị bỏ trống, nó sẽ tự động được đặt tên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单条内容留空则自动命名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一內容留空則自動命名"
          }
        }
      }
    },
    "去广告、自动测速，含国外媒体、电报、微软和苹果分流。": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الإعلانات، ويقيس السرعة تلقائيًا، ويتضمن الوسائط الأجنبية، وTelegram، وMicrosoft، وApple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Werbung, misst automatisch die Geschwindigkeit und schließt ausländische Medien, Telegram, Microsoft und Apple ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes ads, automatically measures speed, and includes foreign media, Telegram, Microsoft, and Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina anuncios, mide automáticamente la velocidad e incluye medios extranjeros, Telegram, Microsoft y Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les publicités, mesure automatiquement la vitesse et inclut les médias étrangers, Telegram, Microsoft et Apple."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus iklan, mengukur kecepatan secara otomatis, dan menyertakan media asing, Telegram, Microsoft, dan Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を削除し、速度を自動的に測定します。海外メディア、Telegram、Microsoft、Apple も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 제거, 속도 자동 측정, 외국 미디어, 텔레그램, 마이크로소프트, 애플 등이 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove anúncios, mede automaticamente a velocidade e inclui mídia estrangeira, Telegram, Microsoft e Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает рекламу, автоматически измеряет скорость, включает зарубежные СМИ, Telegram, Microsoft и Apple."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบโฆษณา วัดความเร็วโดยอัตโนมัติ และรวมถึงสื่อต่างประเทศ Telegram, Microsoft และ Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamları kaldırır, hızı otomatik olarak ölçer ve yabancı medya, Telegram, Microsoft ve Apple'ı içerir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa quảng cáo, tự động đo tốc độ và bao gồm các phương tiện truyền thông nước ngoài, Telegram, Microsoft và Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去广告、自动测速，含国外媒体、电报、微软和苹果分流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去廣告、自動測速，含國外媒體、電報、微軟和蘋果分流。"
          }
        }
      }
    },
