        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các liên kết đăng ký tháp đã được thêm vào máy tính hoặc bộ định tuyến sẽ không còn hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已经添加到电脑或路由器的塔台订阅链接都会失效。"
