    "%@ %lld 个节点，跳过 %lld 条无法识别": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld العقد، تم تخطي %3$lld غير معروف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld Knoten, übersprungen %3$lld nicht erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld nodes, skipped %3$lld unrecognized"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld nodos, omitidos %3$lld no reconocidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld nœuds ignorés %3$lld non reconnus"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld node, dilewati %3$lld tidak dikenali"
